# Copiar a .env y completar. Nunca subir .env al repositorio.

# --- Entorno ---
APP_ENV=dev                      # dev | test | prod
LOG_LEVEL=INFO

# --- Base de datos (PostgreSQL + PostGIS) ---
POSTGRES_DB=streetrepo
POSTGRES_USER=streetrepo
POSTGRES_PASSWORD=cambiar-esta-clave
POSTGRES_HOST=db
POSTGRES_PORT=5432
# Puerto del host para la base de Docker (5433 evita chocar con un PostgreSQL local)
DB_HOST_PORT=5433

# --- API ---
API_PORT=8000
# Orígenes permitidos para CORS, separados por coma (solo el panel administrativo)
CORS_ORIGINS=http://localhost:5173

# Proxies de confianza para X-Forwarded-For (IP real del cliente en el límite de intentos).
# Con el proxy HTTPS (HU-17), poner su dirección. Nunca '*': la API no arranca.
FORWARDED_ALLOW_IPS=127.0.0.1

# --- Autenticación (JWT) ---
# Obligatoria: clave aleatoria de al menos 32 caracteres, generada con `openssl rand -hex 32`.
JWT_SECRET_KEY=
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7

# --- Política de tratamiento de datos (Ley 1581): versión vigente ---
PRIVACY_POLICY_VERSION=1.0

# --- Carga OSM (Overpass). Área: sur,oeste,norte,este ---
OSM_BBOX=1.16,-77.33,1.25,-77.23
OVERPASS_URL=https://overpass-api.de/api/interpreter
# Identifica la aplicación ante Overpass/Nominatim; añadir un correo de contacto real
OSM_USER_AGENT=StreetRepo/0.1 (proyecto de grado, Universidad Cooperativa de Colombia - Pasto)

# --- Mapas (proveedor de tiles configurable, ver guía 3.1) ---
TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
