# Copiar a .env y completar. Nunca subir .env al repositorio.

# --- Entorno ---
APP_ENV=dev                      # dev | test | prod
LOG_LEVEL=INFO

# --- Base de datos (PostgreSQL + PostGIS) ---
POSTGRES_DB=streetrepo
POSTGRES_USER=streetrepo
POSTGRES_PASSWORD=cambiar-esta-clave
POSTGRES_HOST=db
POSTGRES_PORT=5432
# Puerto del host para la base de Docker (5433 evita chocar con un PostgreSQL local)
DB_HOST_PORT=5433

# --- API ---
API_PORT=8000
# Orígenes permitidos para CORS, separados por coma (solo el panel administrativo)
CORS_ORIGINS=http://localhost:5173

# --- Mapas (proveedor de tiles configurable, ver guía 3.1) ---
TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
