# Copia este archivo como .env.local para desarrollar con "npm run dev".
# Origen de la API (sin barra final). Obligatorio.
VITE_API_BASE_URL=http://localhost:8000
# Proveedor de teselas del mapa (guía 3.1). Si se omite, se usa el público de OpenStreetMap.
VITE_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
