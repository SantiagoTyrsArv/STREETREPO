<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 o superior: nada de la app se copia a la nube ni a otro equipo. Los tokens
     del almacenamiento seguro no se pueden descifrar fuera de este Keystore y no deben salir
     del teléfono (propuesta 53, guía 7.3, Ley 1581). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
